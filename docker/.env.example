# Vorlage für docker-compose.prod.yml. Als .env neben die Compose-Datei
# kopieren und ausfüllen. Docker Compose liest $ in Werten als Variable, ein
# Passwort mit $ deshalb in einfache Anführungszeichen setzen.

# Image-Version. Leer bedeutet latest, also die neueste stabile Version.
# Eine feste Version wie v2026.1.0 hält die Instanz auf diesem Stand, die
# Versionen stehen unter github.com/EmergencyForge/ignis/releases.
IMAGE_TAG=

# Port auf 127.0.0.1, an den der Reverse Proxy weiterleitet
# IGNIS_PORT=8080

# Datenbank. Mit dem db-Dienst aus der Compose-Datei legt MariaDB Benutzer
# und Datenbank beim ersten Start mit diesen Werten an.
DB_NAME=ignis
DB_USER=ignis
DB_PASS=
# Nur für eine externe Datenbank statt des db-Dienstes
# DB_HOST=db.example.de
# DB_PORT=3306

# Discord-Anwendung (discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Öffentliche Adresse der Instanz. Steht sie hier, ist sie in den
# Einstellungen nicht mehr änderbar.
SYSTEM_URL=https://ignis.example.de

# Nur nötig, wenn die Callback-Adresse hinter dem Proxy falsch hergeleitet
# wird. Muss identisch im Discord Developer Portal stehen.
# DISCORD_REDIRECT_URI=https://ignis.example.de/auth/callback.php

# debug, info, notice, warning, error
# LOG_LEVEL=warning
