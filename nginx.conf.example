# ============================================================
# ıgnıs: Nginx Konfiguration (Beispiel)
# ============================================================
#
# Diese Datei ist eine Referenz-Konfiguration für Nginx.
# Apache-User brauchen diese Datei NICHT, die .htaccess-Dateien
# im Projekt übernehmen dort alles automatisch.
#
# Das Docroot ist das Verzeichnis public/ im Projekt. Alles andere
# (src/, plugins/, storage/, vendor/, .env) liegt außerhalb und wird
# vom Webserver nie angefasst. Die Durchreichung über die Root-
# .htaccess gibt es unter Nginx nicht, deshalb MUSS `root` auf public/ zeigen.
#
# Anleitung:
#   1. Die map{}-Blöcke MÜSSEN im http{}-Block stehen
#      (nicht innerhalb von server{}!)
#   2. Den server{}-Block in deine Site-Config kopieren
#   3. Alle Stellen mit "<-- anpassen" an deine Umgebung anpassen
#   4. Testen:  sudo nginx -t
#   5. Laden:   sudo systemctl reload nginx
#
# ============================================================

# --------------------------------------------------------
# MAP-Direktiven (MÜSSEN im http{}-Block stehen,
# NICHT innerhalb von server{})
# --------------------------------------------------------

# FiveM (CitizenFX) User-Agent erkennen und CSP/X-Frame-Options
# dynamisch setzen. Ohne das zeigt FiveM nur einen weissen Bildschirm,
# weil CSP das nui:// Protokoll blockiert.
map $http_user_agent $csp_header {
    default "frame-ancestors 'self' https://*";
    ~*CitizenFX "";
}

map $http_user_agent $frame_options {
    default "SAMEORIGIN";
    ~*CitizenFX "";
}

# ============================================================
# Server-Block
# ============================================================

server {
    listen 443 ssl http2;
    server_name example.com;           # <-- anpassen

    root /var/www/intraRP/public;      # <-- Pfad zum Projekt anpassen, /public bleibt
    index index.php;

    # SSL (Pflicht, Sessions funktionieren nur mit SSL!)
    ssl_certificate     /etc/ssl/certs/example.crt;      # <-- anpassen
    ssl_certificate_key /etc/ssl/private/example.key;     # <-- anpassen

    # ====================================================
    # Security Headers
    # ====================================================

    add_header Content-Security-Policy $csp_header always;
    add_header X-Frame-Options $frame_options always;

    # ====================================================
    # Allgemeine Einstellungen
    # ====================================================

    autoindex off;
    # Passend zu post_max_size (55M) und upload_max_filesize (50M) in
    # docker/php.ini. Bei eigener PHP-Installation dieselben Werte setzen.
    client_max_body_size 55M;

    # Let's Encrypt (HTTP-01) braucht /.well-known trotz der Sperre darunter.
    # ^~ hat Vorrang vor der Regex-Location.
    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        try_files $uri =404;
    }

    # Versteckte Dateien nie ausliefern (.htaccess liegt auch in public/)
    location ~ /\. {
        return 403;
    }

    # ====================================================
    # Request-Dispatch
    # ====================================================
    #
    # In public/ liegen nur die gebauten Assets, index.php und cron.php.
    # Alles, was keine echte Datei ist, geht an den Front-Controller:
    # Seiten, API, Plugin-Assets (/plugins/<id>/assets/...) und Uploads
    # (/storage/profile-pictures/..., /storage/documents/...) liefert er
    # über Routen aus, jeweils mit eigener Endungs-Allowlist.
    #
    # Legacy `*.php`-Aufrufe (z. B. `/login.php` aus alten Bookmarks)
    # landen ebenfalls im Front-Controller. Die dort eingebaute Bridge
    # antwortet bei GET/HEAD mit einem 301 auf die Clean-URL und schreibt
    # POST/PUT/DELETE intern um, damit Form-Submits ihren Body behalten.

    # Links auf "public/assets/..." aus der Zeit vor dem Umzug
    location ^~ /public/ {
        rewrite ^/public/(.+)$ /$1 last;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    # ====================================================
    # PHP-FPM
    # ====================================================

    location ~ \.php$ {
        # Nur die beiden echten PHP-Dateien in public/ ausführen
        try_files $uri =404;

        # Backend-Header entfernen (damit sie nicht mit Nginx-Headern kollidieren)
        fastcgi_hide_header Content-Security-Policy;
        fastcgi_hide_header X-Frame-Options;

        fastcgi_pass unix:/run/php/php8.3-fpm.sock;   # <-- PHP-Version anpassen
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        include fastcgi_params;

        # Timeout für lange Anfragen (z.B. EMD-Sync)
        fastcgi_read_timeout 120s;
    }

    # ====================================================
    # Statische Dateien: Caching
    # ====================================================

    # Skripte und Styles ohne Langzeit-Cache, wie in public/.htaccess: die
    # ES-Module laden ihre Abhängigkeiten ohne Versionsangabe (./drawer.js),
    # nach einem Update hielte der Browser sonst die alte Fassung. Mit ETag
    # kostet die Nachfrage nur ein 304.
    location ~* \.(css|js|mjs|map|json)$ {
        try_files $uri /index.php$is_args$args;
        add_header Cache-Control "no-cache";

        # Header müssen in jedem Block wiederholt werden (Nginx-Verhalten)
        add_header Content-Security-Policy $csp_header always;
        add_header X-Frame-Options $frame_options always;
    }

    # Schriften und Bilder ändern sich zwischen Releases selten
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        try_files $uri /index.php$is_args$args;
        expires 7d;
        add_header Cache-Control "public";

        add_header Content-Security-Policy $csp_header always;
        add_header X-Frame-Options $frame_options always;
    }
}

# ====================================================
# HTTP → HTTPS Redirect
# ====================================================

server {
    listen 80;
    server_name example.com;       # <-- anpassen

    # Zertifikats-Erneuerung läuft über Port 80
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/intraRP/public;   # <-- wie oben
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}


# ============================================================
# VARIANTE: ignis im Docker-Container (docker-compose.prod.yml)
# ============================================================
#
# Der Container bringt Apache und PHP mit und lauscht auf
# 127.0.0.1:8080. Nginx reicht dann nur noch durch und ersetzt den
# server{}-Block oben. Adressen und Weiterleitungen leitet ignis aus
# X-Forwarded-Proto und X-Forwarded-Host ab; fehlen sie, erzeugt es
# http://-Links auf 127.0.0.1. CSP und X-Frame-Options (FiveM) setzt
# die Anwendung im Container selbst, die map{}-Blöcke braucht es hier
# nicht.
#
# server {
#     listen 443 ssl http2;
#     server_name example.com;                          # <-- anpassen
#
#     ssl_certificate     /etc/ssl/certs/example.crt;   # <-- anpassen
#     ssl_certificate_key /etc/ssl/private/example.key; # <-- anpassen
#
#     client_max_body_size 55M;
#
#     location / {
#         proxy_pass http://127.0.0.1:8080;
#         proxy_set_header Host              $host;
#         proxy_set_header X-Forwarded-Host  $host;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#         proxy_set_header X-Real-IP         $remote_addr;
#         proxy_read_timeout 120s;
#     }
# }


# ============================================================
# FEHLERBEHEBUNG: FiveM zeigt weissen Bildschirm
# ============================================================
#
# Symptom:
#   Tablet (eNOTF/fireTab) in FiveM zeigt nur weiss,
#   im normalen Browser funktioniert alles.
#
# Ursache:
#   FiveM nutzt CEF (Chromium Embedded Framework) mit dem
#   User-Agent "CitizenFX". CSP-Header blockieren das
#   nui:// Protokoll, X-Frame-Options verhindert das Einbetten.
#
# Lösung (bereits in dieser Config eingebaut):
#   1. Die map-Direktiven erkennen "CitizenFX" im User-Agent
#   2. Für FiveM-Requests werden CSP + X-Frame-Options geleert
#   3. fastcgi_hide_header verhindert doppelte Header
#
# Diagnose:
#   - sudo nginx -t               → Syntax prüfen
#   - sudo systemctl reload nginx  → Config neu laden
#   - FiveM: F8-Konsole            → nach Fehlern suchen
#   - Browser: F12 → Network Tab   → Response Headers prüfen
#     → CSP sollte vorhanden sein (normaler Browser)
#     → CSP sollte LEER sein (FiveM-Request)
#
# Debug:
#   config.lua: Config.Debug = true
#   F8-Konsole öffnen, Ticket mit Logs eröffnen.
#
# WICHTIG: Sessions funktionieren nur mit SSL!
# ============================================================
