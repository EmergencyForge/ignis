# ıgnıs — Root-.htaccess
#
# Das Docroot ist public/. Zeigt der Webserver dorthin, liest Apache diese
# Datei nie. Sie ist für Installationen da, deren Docroot nicht umgestellt
# werden kann (Webspace ohne Einstellung): Dann reicht sie jede Anfrage
# nach public/ durch, wo public/.htaccess den Rest erledigt, und hält die
# Sperren für alles aufrecht, was nie über HTTP erreichbar sein darf.

#1 ---- Prevent listing

IndexIgnore *
Options -Indexes

#1b ---- Security: Block sensitive files
#
# Apache 2.4 verwendet `Require all denied`. Falls noch Apache 2.2 im Einsatz
# ist, greift `Order/Deny` als Fallback. Beide Direktiven nebeneinander sind
# erlaubt — die nicht passende wird ignoriert.

# Block alle .env-Varianten (.env, .env.test, .env.local, .env.production, ...)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Phinx-Config (wird nur von CLI gelesen, nicht via HTTP)
<Files "phinx.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Block Composer/Build-Konfigurationen
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json|phpstan\.neon|phpunit\.xml(\.dist)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

#2 ---- Rewrites

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Interne Verzeichnisse bleiben gesperrt, auch wenn die Durchreichung
    # unten sie ohnehin nie erreichen würde. Doppelt hält besser, falls
    # jemand die Regel darunter anpasst. plugins/ steht nicht in der Liste:
    # Plugin-Assets laufen über die Route /plugins/<id>/assets/... und
    # müssen deshalb nach public/ durchkommen.
    RewriteRule ^src/ - [F,L]
    RewriteRule ^cli/ - [F,L]
    RewriteRule ^tools/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^docker/ - [F,L]
    RewriteRule ^routes/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^\.github/ - [F,L]

    # Alles nach public/ durchreichen — es sei denn, die Anfrage zeigt
    # schon dorthin (das ist nach dem internen Redirect der Fall). Dort
    # liefert public/.htaccess echte Dateien aus und schickt den Rest an
    # index.php. Die Bedingung prüft die Rückreferenz der Regel, damit
    # auch Installationen in einem Unterverzeichnis funktionieren.
    RewriteCond $1 !^public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
