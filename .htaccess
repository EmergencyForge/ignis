#1 ---- Prevent listing

IndexIgnore *
Options -Indexes

#1b ---- Security: Block sensitive files
#
# Apache 2.4 verwendet `Require all denied`. Falls noch Apache 2.2 im Einsatz
# ist, greift `Order/Deny` als Fallback. Beide Direktiven nebeneinander sind
# erlaubt — die nicht passende wird ignoriert.

# Block alle .env-Varianten (.env, .env.test, .env.local, .env.production, ...)
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block Phinx-Config (wird nur von CLI gelesen, nicht via HTTP)
<Files "phinx.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Block Composer/Build-Konfigurationen
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json|phpstan\.neon|phpunit\.xml(\.dist)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block interne Verzeichnisse komplett vor direktem Web-Zugriff.
# Diese Ordner enthalten Quellcode, CLI-Scripts, Tools und Legacy-Code,
# die niemals direkt über HTTP erreichbar sein sollen — sie werden
# entweder aus anderen Scripts includiert oder nur über die CLI aufgerufen.
RewriteRule ^src/ - [F,L]
RewriteRule ^cli/ - [F,L]
RewriteRule ^tools/ - [F,L]
RewriteRule ^tests/ - [F,L]
RewriteRule ^database/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^docker/ - [F,L]
RewriteRule ^routes/ - [F,L]
RewriteRule ^\.github/ - [F,L]
# Aktive Plugins dürfen ausschließlich fertig gebaute, statische Dateien aus
# ihrem assets/-Ordner ausliefern. Alles andere bleibt gesperrt; die zweite
# Schutzschicht in plugins/.htaccess prüft dieselbe Allowlist.
RewriteRule ^plugins/[a-z0-9_-]+/assets/(?:.+/)?[^/]+\.(?:css|js|map|woff2|png|svg|webp)$ - [L,NC]
RewriteRule ^plugins/ - [F,L]

# cron/ bleibt erreichbar, weil HTTP-triggerbare Cron-Endpoints dort liegen
# (queue-worker-cron.php, telemetry-cron.php). Diese prüfen API-Key intern
# und sind die einzigen expliziten Einsprungspunkte — andere Dateien dort
# werden nicht erstellt, aber Legacy-Datei-Schutz hängt an den Script-Checks.

#2 ---- Rewrites

RewriteEngine On

# ============================================================
# Router Fallback
#
# Greift, wenn der Request weder auf eine echte Datei noch auf
# ein echtes Verzeichnis zeigt, und leitet ihn an den Single-
# Entry-Point `public/index.php` weiter, wo `App\Http\Router`
# das Matching übernimmt. eNOTF-Clean-URLs (`/enotf/p/{enr}/...`)
# sind direkt im Router registriert.
#
# Bestehende Modul-Files (benutzer/list.php, einsatz/index.php, ...)
# bleiben unberührt, weil `!-f` dann false ist und die Regel nicht
# greift. Extension-lose URLs auf echte Files (z.B. Form-Actions wie
# assets/functions/enotf/enrbridge) mappt die `.php`-Regel davor —
# analog zum `$uri.php`-Schritt in der nginx.conf.example.
# ============================================================

# Extensionslose URLs -> .php. Ersetzt MultiViews, das auf PHP-FPM-Setups
# (KeyHelp, Plesk, ...) stillschweigend versagt, weil mod_negotiation
# .php ohne mod_mime-Typ nicht als Variante erkennt.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [L,QSA]
