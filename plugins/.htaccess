# Plugins sind Anwendungscode. Öffentlich sind nur statische Dateien aus
# plugins/<id>/assets/ mit einer kleinen Endungs-Allowlist. PHP, Templates,
# Manifest, Migrationen und beliebige Dateien außerhalb von assets/ bleiben
# auch dann gesperrt, wenn sie eine vermeintlich harmlose Endung tragen.
SetEnvIf Request_URI "/plugins/[a-z0-9_-]+/assets/(?:.+/)?[^/]+\.(css|js|map|woff2|png|svg|webp)$" plugin_static_asset=1

<IfModule mod_authz_core.c>
    <RequireAny>
        Require env plugin_static_asset
    </RequireAny>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    Allow from env=plugin_static_asset
</IfModule>
