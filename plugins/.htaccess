# Plugins sind Anwendungscode und liegen außerhalb des Docroots (public/).
# Ihre statischen Dateien liefert die Route /plugins/<id>/assets/... aus,
# der Webserver hat hier nichts mehr zu suchen. Diese Datei greift nur,
# wenn eine Installation das Docroot nicht auf public/ umstellen kann und
# der Ordner deshalb noch im Webserver-Pfad liegt: dann ist er komplett zu.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
