APP_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ignis
DB_USER=ignis
DB_PASS=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Nur noetig, wenn ignis hinter einem Reverse Proxy steht und die Adresse nicht
# selbst richtig herleitet. Muss identisch im Discord Developer Portal stehen.
# DISCORD_REDIRECT_URI=https://deine-instanz.example.de/auth/callback.php

# Logging (optional)
# LOG_LEVEL=warning
# LOG_PATH=storage/logs

# Zentrale Anmeldung fuer Instanzen, die EmergencyForge selbst betreibt (siehe
# EMERGENCYFORGE_AUTH.md). Fuer eigene Installationen so lassen.
AUTH_MODE=direct-discord
# FABRICA_URL=https://console.emergencyforge.de
# FABRICA_INSTANCE_ID=
# FABRICA_INSTANCE_CREDENTIAL=

# Schluessel fuer Geheimnisse in der Datenbank (etwa das Token des Discord-Bots).
# Leer lassen: ignis legt beim ersten Bedarf storage/private/secret.key an, die
# Datei gehoert dann ins Backup. Selbst setzen mit: openssl rand -base64 32
# APP_KEY=
